#!/bin/bash
set -u

temp_log() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" >"${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    else
        printf '%s\n' "$*" >&2
    fi
}

writable_var() {
    [ -w "${TRIM_PKGVAR}" ] || return 1
    if [ -d "${TRIM_PKGVAR}/config" ] && [ ! -w "${TRIM_PKGVAR}/config" ]; then
        return 1
    fi
    return 0
}

if [ -z "${TRIM_PKGVAR:-}" ] || [ -z "${TRIM_APPDEST:-}" ]; then
    temp_log "GitLab 配置参数不完整"
    exit 1
fi
python3 "${TRIM_APPDEST}/bin/sync_config.py" --mode save >>"${TRIM_PKGVAR}/install.log" 2>&1
rc=$?
if [ "${rc}" -eq 2 ]; then
    temp_log "GitLab 配置无效，请检查域名和端口"
    exit 2
fi
if [ "${rc}" -ne 0 ]; then
    temp_log "GitLab 配置保存将在首次启动时由系统修复"
    exit 0
fi
exit 0

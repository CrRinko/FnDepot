#!/bin/bash
set -u

delete_contents() {
    local dir="$1" left
    [ -n "${dir}" ] || return 0
    [ -d "${dir}" ] || return 0
    rm -rf "${dir}"/* "${dir}"/.[!.]* 2>/dev/null || true
    left="$(ls -A "${dir}" 2>/dev/null | wc -l | tr -d ' ')"
    if [ "${left:-0}" != "0" ] && command -v docker >/dev/null 2>&1 &&
        docker image inspect gitlab/gitlab-ce:19.5.3-ce.0 >/dev/null 2>&1; then
        docker run --rm --entrypoint /bin/sh \
            -v "${dir}:/wipe" gitlab/gitlab-ce:19.5.3-ce.0 \
            -c 'rm -rf /wipe/* /wipe/.[!.]*' >/dev/null 2>&1 || true
        left="$(ls -A "${dir}" 2>/dev/null | wc -l | tr -d ' ')"
    fi
    if [ "${left:-0}" != "0" ]; then
        printf 'RESIDUAL_COUNT=%s in %s\n' "${left}" "${dir}"
        return 1
    fi
    return 0
}

temp_log() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" >"${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
    fi
}

if [ "${wizard_data_action:-keep}" = "delete" ]; then
    if [ -n "${TRIM_PKGVAR:-}" ]; then
        if ! delete_contents "${TRIM_PKGVAR}"; then
            temp_log "GitLab 数据未能完全删除，请手动清理 ${TRIM_PKGVAR}"
            exit 1
        fi
    fi
fi
exit 0

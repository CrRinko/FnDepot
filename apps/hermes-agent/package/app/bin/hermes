#!/bin/bash
set -e
TRIM_PKGHOME="${TRIM_PKGHOME:-/vol1/@apphome/hermes-agent}"
DATA_DIR="${TRIM_PKGHOME}/data"
RUNTIME="${TRIM_PKGHOME}/runtime"
export HOME="${DATA_DIR}"
export HERMES_HOME="${DATA_DIR}"
export PATH="${RUNTIME}/venv/bin:${RUNTIME}/node/bin:${RUNTIME}/bin:/var/apps/nodejs_v24/target/bin:/vol1/@appcenter/nodejs_v24/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}"
exec "${RUNTIME}/venv/bin/hermes" "$@"
